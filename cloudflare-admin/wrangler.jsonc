{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "performance-vehicles-admin",
  "main": "dist/worker.js",
  "compatibility_date": "2026-10-30",
  "workers_dev": false,
  "preview_urls": false,
  "no_bundle": true,
  "build": { "command": "npm run build" },
  "vars": {
    "ADMIN_EMAILS": "conor@moreydigital.ie",
    "PUBLIC_SITE_URL": "https://performancevehicles.ie"
  },
  "observability": { "enabled": false }
}
